# Required for AI features (get from https://console.anthropic.com)
ANTHROPIC_API_KEY=your_key_here

# Database (SQLite file path). Relative paths resolve against prisma/.
# Local launchd setup: keep the DB outside the checkout, e.g.
# DATABASE_URL="file:/Users/<you>/Library/Application Support/smartbrief/smartbrief.db"
# (scripts/migrate-db-location.sh moves an existing prisma/dev.db there)
DATABASE_URL=file:./dev.db

# Optional: password protection (leave empty to disable)
SMARTBRIEF_PASSWORD=your_password_here

# Optional: use the locally logged-in Claude Code CLI (Claude Agent SDK) instead of an API key
CLAUDE_USE_LOCAL_SDK=false

# Optional: article retention in days (default 30, 0 = keep everything).
# Values below 30 also shorten the 14/30-day recap views.
# Saved articles and articles in saved or current top stories are never pruned.
SMARTBRIEF_RETENTION_DAYS=30
