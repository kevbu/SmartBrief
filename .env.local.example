# Required for AI features (get from https://console.anthropic.com)
ANTHROPIC_API_KEY=your_key_here

# Database (SQLite file path)
DATABASE_URL=file:./dev.db

# Optional: password protection (leave empty to disable)
SMARTBRIEF_PASSWORD=your_password_here

# Optional: use the locally logged-in Claude Code CLI (Claude Agent SDK) instead of an API key
CLAUDE_USE_LOCAL_SDK=false
